SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Central (default) database — the MySQL user below must have CREATE
# privileges, since new tenant databases are created dynamically using
# this same connection (see tenants/provisioning.py).
DB_ENGINE=django.db.backends.mysql
DB_NAME=tenant_platform_central
DB_USER=root
DB_PASSWORD=admin@123
DB_HOST=localhost
DB_PORT=3306

# Encrypts Tenant.db_password at rest (see tenants/crypto.py) — generate your
# own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit a real key; rotating it makes every already-encrypted
# db_password unreadable, so back it up like any other production secret.
FIELD_ENCRYPTION_KEY=GguABvMkPiRx6JplOJpHIUVvoh89nS7UFTn-TO8tZvA=
